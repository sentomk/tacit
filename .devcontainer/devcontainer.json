{
  "name": "tacit",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "dev",
  "mounts": [
    "source=tacit-micromamba,target=/home/dev/micromamba,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/python -m pip install -e '.[dev]' && cmake --preset debug && cmake --build --preset debug --parallel 2 && ctest --preset debug"
}
